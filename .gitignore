# Rust
/target

# Zig deps build artifacts
/deps/zig-out/
/deps/.zig-cache/
/deps/zig-pkg/

# Reference checkout (git clone of the krkr2 emulator)
/reference/

# Editor / OS
*.swp
.DS_Store
__pycache__/

# Android / Gradle
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/*.iml
# Signing material must never be committed: a keystore is the app's permanent
# identity, and committing one would let anyone publish as this package. The
# release key lives outside the repo and CI gets it from a secret.
*.jks
*.keystore
# The engine shared library is a build artifact, produced by
# `cargo ndk -t arm64-v8a -o android/app/src/main/jniLibs build -p krkr-android`.
# It must never be committed — it is architecture- and build-specific, and
# regenerating it is what the Android build does.
/android/app/src/main/jniLibs/
