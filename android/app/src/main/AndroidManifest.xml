<?xml version="1.0" encoding="utf-8"?>
<!--
  krkr-rs Android manifest (experimental). See docs/android.md.

  Two activities:
    * MainActivity       — the Material 3 launcher (game library + SAF picker)
    * KrkrGameActivity   — hosts the engine surface (AGDK GameActivity)

  MANAGE_EXTERNAL_STORAGE is requested because the engine's storage layer is
  path-based and the games' XP3 archives live in shared storage (docs/android.md
  §4, option A). It is a Play-policy-restricted permission, acceptable for the
  current sideloaded/experimental scope; the policy-clean alternative is a
  SAF-backed storage backend (option B).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- No READ_EXTERNAL_STORAGE: it is a no-op from API 33 and the app is
         Android 15+ (minSdk 35), so MANAGE_EXTERNAL_STORAGE is the only
         storage permission that does anything here. -->

    <!-- The engine renders with wgpu (Vulkan, falling back to GLES). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Krkr"
        android:extractNativeLibs="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The engine Activity. `android.app.lib_name` is how the AGDK
          GameActivity finds the native entry point; it must match the cdylib
          name produced by `crates/android/build-android.sh` (crates/android
          `[lib] name`).
        -->
        <activity
            android:name=".KrkrGameActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Krkr.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data
                android:name="android.app.lib_name"
                android:value="krkr_android" />
        </activity>
    </application>
</manifest>
