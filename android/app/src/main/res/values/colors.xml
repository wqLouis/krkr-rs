<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive launcher icon's background layer (mipmap-anydpi-v26/ic_launcher.xml).
  Its source, `icons/ic_launcher_background · 108 × 108.svg`, is a single flat
  rectangle of #123E42, so the layer is stored as this colour rather than as an
  image. Changing this one value re-tints the icon on API 26+ without
  regenerating any image.
-->
<resources>
    <color name="ic_launcher_background">#FF123E42</color>
</resources>
