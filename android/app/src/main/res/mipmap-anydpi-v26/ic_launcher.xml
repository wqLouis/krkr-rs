<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The foreground is the logo from the
  repository's `icon.png`, scaled into the 72dp safe zone of the 108dp canvas;
  the background is a flat colour.

  The logo has a transparent background and is predominantly blue, so the
  background is kept light for contrast — change `ic_launcher_background` in
  `values/colors.xml` to re-tint it, no image regeneration needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
