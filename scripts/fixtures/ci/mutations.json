[
  {
    "name": "tag pattern",
    "old": "      - 'v*'",
    "new": "      - 'release-*'",
    "rule": "trigger-v"
  },
  {
    "name": "android tag",
    "old": "      - 'v*'",
    "new": "      - 'android-*'",
    "rule": "no-android-tag"
  },
  {
    "name": "branch push",
    "old": "  push:\n",
    "new": "  push:\n    branches: [main]\n",
    "rule": "trigger-branches"
  },
  {
    "name": "manual dispatch",
    "old": "  workflow_dispatch:\n",
    "new": "",
    "rule": "dispatch"
  },
  {
    "name": "gate job",
    "old": "\n  gate:\n",
    "new": "\n  checks:\n",
    "rule": "job-gate"
  },
  {
    "name": "linux job",
    "old": "\n  linux:\n",
    "new": "\n  desktop:\n",
    "rule": "job-linux"
  },
  {
    "name": "android job",
    "old": "\n  apk:\n",
    "new": "\n  android:\n",
    "rule": "job-android"
  },
  {
    "name": "release job",
    "old": "\n  release:\n",
    "new": "\n  publish:\n",
    "rule": "job-release"
  },
  {
    "name": "gate command",
    "old": "uv run --project scripts krkr-gate gate",
    "new": "echo static gate",
    "rule": "gate-command"
  },
  {
    "name": "gate uv",
    "old": "astral-sh/setup-uv@v5",
    "new": "actions/setup-python@v5",
    "rule": "gate-uv"
  },
  {
    "name": "gate rust",
    "old": "dtolnay/rust-toolchain@stable",
    "new": "actions/setup-rust@v1",
    "rule": "gate-rust"
  },
  {
    "name": "gate dependencies",
    "old": "libavcodec-dev",
    "new": "ffmpeg",
    "rule": "gate-deps"
  },
  {
    "name": "linux waits for gate",
    "old": "  linux:\n    name: Linux x86_64 binary\n    needs: gate",
    "new": "  linux:\n    name: Linux x86_64 binary\n    needs: []",
    "rule": "linux-needs-gate"
  },
  {
    "name": "linux build",
    "old": "cargo build --release -p app",
    "new": "cargo build -p app",
    "rule": "linux-build"
  },
  {
    "name": "linux archive",
    "old": "tar -czf krkr-rs-linux-x86_64.tar.gz",
    "new": "tar -czf krkr-linux.tar.gz",
    "rule": "linux-package"
  },
  {
    "name": "linux license",
    "old": "cp LICENSE dist/LICENSE",
    "new": "cp NOTICE dist/NOTICE",
    "rule": "linux-contents"
  },
  {
    "name": "linux artifact",
    "old": "          name: krkr-rs-linux-x86_64",
    "new": "          name: linux-binary",
    "rule": "linux-artifact"
  },
  {
    "name": "android waits for gate",
    "old": "  apk:\n    name: Release APK\n    needs: gate",
    "new": "  apk:\n    name: Release APK\n    needs: []",
    "rule": "android-needs-gate"
  },
  {
    "name": "android build script",
    "old": "crates/android/build-android.sh",
    "new": "crates/android/build.sh",
    "rule": "android-build"
  },
  {
    "name": "android packaging check",
    "old": "crates/android/check-jni-libs.sh",
    "new": "crates/android/check.sh",
    "rule": "android-jni-check"
  },
  {
    "name": "android artifact",
    "old": "          name: krkr-rs-release-arm64-v8a",
    "new": "          name: android-apk",
    "rule": "android-artifact"
  },
  {
    "name": "release waits for both",
    "old": "needs: [linux, apk]",
    "new": "needs: linux",
    "rule": "release-needs"
  },
  {
    "name": "release downloads both artifacts",
    "old": "      - name: Download the APK\n        uses: actions/download-artifact@v4\n        with:\n          name: krkr-rs-release-arm64-v8a",
    "new": "      - name: Download the APK\n        uses: actions/download-artifact@v4\n        with:\n          name: android-apk",
    "rule": "release-assets"
  },
  {
    "name": "release create",
    "old": "gh release create",
    "new": "gh release list",
    "rule": "release-create"
  },
  {
    "name": "release upload",
    "old": "gh release upload",
    "new": "gh release list",
    "rule": "release-upload"
  },
  {
    "name": "release attaches both assets",
    "old": "gh release create \"$tag\" \"$linux\" \"$apk\" --verify-tag",
    "new": "gh release create \"$tag\" \"$linux\" --verify-tag",
    "rule": "release-assets"
  },
  {
    "name": "single publisher",
    "old": "cargo build --release -p app",
    "new": "cargo build --release -p app\n          gh release create evil",
    "rule": "release-single"
  },
  {
    "name": "single uploader",
    "old": "cargo build --release -p app",
    "new": "cargo build --release -p app\n          gh release upload evil",
    "rule": "release-single"
  }
]
